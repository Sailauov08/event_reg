{
  "info": {
    "name": "Lab 7 - Event Registration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Get every event: 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/events"
      }
    },
    {
      "name": "2. Get event by ID: 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/events/1"
      }
    },
    {
      "name": "3. Missing ID: 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/events/999"
      }
    },
    {
      "name": "4. Search title: 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/events?title=quiz"
      }
    },
    {
      "name": "5. No matches: 200 []",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/events?title=not-found"
      }
    },
    {
      "name": "6. Create event: 201 (fresh run: ID 4)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Python Workshop\",\n  \"location\": \"Room 105\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7. Update the created event: 200",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/events/4",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Python Course\",\n  \"location\": \"Room 106\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. Verify update: 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/events/4"
      }
    },
    {
      "name": "9. Delete: 204",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/events/4"
      }
    },
    {
      "name": "10. Verify deletion: 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/events/4"
      }
    },
    {
      "name": "11. Update missing ID: 404",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/events/999",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Unknown\",\n  \"location\": \"Room 1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12. Delete missing ID: 404",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/events/999"
      }
    },
    {
      "name": "13. Invalid title: 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"location\": \"Room 101\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "14. Confirm there are still three events: 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/events"
      }
    },
    {
      "name": "15. New ID must be 5: 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"AI Talk\",\n  \"location\": \"Room 107\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "16. Restart app before running: original three events",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/events"
      }
    }
  ]
}